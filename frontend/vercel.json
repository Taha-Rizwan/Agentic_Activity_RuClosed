{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ruclosed.onrender.com/api/:path*" },
    { "source": "/a/:slug/p/:id", "destination": "/property.html" },
    { "source": "/a/:slug", "destination": "/agency.html" },
    { "source": "/admin/dashboard", "destination": "/admin/dashboard.html" },
    { "source": "/admin", "destination": "/admin/login.html" }
  ]
}
