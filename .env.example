# Copy to .env and fill in. NEVER commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# Model required by the hackathon brief
MODEL=claude-haiku-5-5
# Long random string used to sign admin + customer tokens
SECRET_KEY=change-me-to-a-long-random-string
# Where SQLite files live (use a mounted disk in production)
DATA_DIR=./data
# Set to 1 to force the offline rule-based model (no API calls, used by tests/CI)
OFFLINE_MODE=0
