# Copy to .env and fill in. NEVER commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# Model required by the hackathon brief
MODEL=claude-haiku-5-5
# Long random string used to sign admin + customer tokens
SECRET_KEY=change-me-to-a-long-random-string
# Production memory + data: Supabase or Neon Postgres connection string.
# Leave empty for local SQLite files. Supabase: use the "Session pooler" URI (port 5432).
DATABASE_URL=
# Tenant used by the open POST /chat API
DEFAULT_AGENCY=capital-estates
# Where local SQLite files live (only used when DATABASE_URL is empty)
DATA_DIR=./data
# Set to 1 to force the offline rule-based model (no API calls, used by tests/CI)
OFFLINE_MODE=0
# LangSmith tracing (optional): see every graph run, node, tool call and middleware step
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2-...
LANGSMITH_PROJECT=ruclosed
